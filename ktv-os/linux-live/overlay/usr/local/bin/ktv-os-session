#!/usr/bin/env bash
# Unprivileged kiosk supervisor. Never repartitions, installs or reboots.
set -u
export HOME="${HOME:-/home/user}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE="$HOME/.config/ktv-os"
mkdir -p "$STATE"
SERVER_LOG="$STATE/server.log"
SESSION_LOG="$STATE/session.log"
if [[ -f "$SESSION_LOG" ]]; then
  tail -c 131072 "$SESSION_LOG" > "$SESSION_LOG.previous" 2>/dev/null || true
fi
: > "$SESSION_LOG"
exec >> "$SESSION_LOG" 2>&1
printf '=== KTV OS 0.5 - sessao iniciada: %s ===\n' "$(date -Is)"
cd /opt/ktv-os || exit 1
SERVER_PID=''
cleanup() {
  if [[ -n "$SERVER_PID" ]]; then
    kill "$SERVER_PID" 2>/dev/null || true
    wait "$SERVER_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM
prompt_recovery() {
  local message="$1"
  printf 'RECUPERACAO: %s\n' "$message"
  if command -v zenity >/dev/null 2>&1; then
    zenity --question --title='KTV OS - Recuperacao' --width=530 \
      --text="$message

Logs: ~/.config/ktv-os/session.log e server.log
Diagnostico: /usr/local/bin/ktv-os-diagnostics
Console Linux: Ctrl+Alt+F2" \
      --ok-label='Tentar novamente' --cancel-label='Sair para diagnostico'
    return $?
  fi
  return 1
}
start_server() {
  if [[ -n "$SERVER_PID" ]] && kill -0 "$SERVER_PID" 2>/dev/null; then return 0; fi
  python3 launcher.py --port 8787 > "$SERVER_LOG" 2>&1 &
  SERVER_PID=$!
  for _ in $(seq 1 40); do
    if curl -fsS --max-time 1 http://127.0.0.1:8787/api/status >/dev/null 2>&1; then
      printf 'Servidor KTV OS disponivel (PID %s)\n' "$SERVER_PID"
      return 0
    fi
    if ! kill -0 "$SERVER_PID" 2>/dev/null; then break; fi
    sleep 0.25
  done
  printf 'Servidor KTV OS nao iniciou. Veja %s\n' "$SERVER_LOG"
  return 1
}
while true; do
  if ! start_server; then
    if prompt_recovery 'Falha ao iniciar o servidor local KTV OS.'; then
      cleanup; SERVER_PID=''
      sleep 2
      continue
    fi
    break
  fi
  crashes=0
  while kill -0 "$SERVER_PID" 2>/dev/null; do
    started="$(date +%s)"
    chromium --no-first-run --disable-session-crashed-bubble \
      --noerrdialogs --password-store=basic \
      --kiosk --app=http://127.0.0.1:8787/ || true
    elapsed=$(( $(date +%s) - started ))
    if (( elapsed < 12 )); then crashes=$((crashes + 1)); else crashes=0; fi
    printf 'Navegador KTV OS terminou apos %s segundos; falhas curtas: %s\n' "$elapsed" "$crashes"
    if (( crashes >= 3 )); then
      if prompt_recovery 'A interface grafica fechou repetidamente. Tentar reinicia-la?'; then
        crashes=0
      else
        break
      fi
    fi
    sleep 2
  done
  if ! kill -0 "$SERVER_PID" 2>/dev/null; then
    if prompt_recovery 'O servidor KTV OS encerrou inesperadamente.'; then
      SERVER_PID=''
      continue
    fi
  fi
  break
done
printf 'KTV OS: supervisor encerrado; console de recuperacao disponivel.\n'
